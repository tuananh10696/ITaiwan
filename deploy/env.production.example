# Mẫu /srv/itaiwan/.env trên VPS.   cp deploy/env.production.example .env && chmod 600 .env
# KHÔNG commit file .env thật (.gitignore đã chặn .env*).

NODE_ENV=production
PORT=3001
APP_URL=https://duhocitaiwan.com

# ---- MySQL cùng máy (không cần SSL; DB_SSL/DB_CA_CERT để trống)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=itaiwan
DB_USER=itaiwan
DB_PASSWORD=

# ---- Đăng nhập. BẮT BUỘC >= 32 ký tự. Sinh:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Tác vụ định kỳ (deploy/chay-cron.sh đọc biến này). Sinh như JWT_SECRET.
CRON_SECRET=

# ---- Gửi mail: 2 kênh, tự chuyển kênh khi một bên lỗi/hết hạn mức (server/utils/email.js)
EMAIL_DRY_RUN=false
EMAIL_FROM_NAME=Trung tâm ITaiwan
EMAIL_REPLY_TO=contact@duhocitaiwan.com

# Kênh 1 — Resend (Free 100 mail/ngày). Domain duhocitaiwan.com phải "Verified" trên Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@duhocitaiwan.com

# Kênh 2 — SMTP Email Doanh Nghiệp Vietnix (200 mail/giờ). Host lấy trong mail bàn giao của Vietnix.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@duhocitaiwan.com
SMTP_PASS=
# Tự dừng trước trần 200/giờ của Vietnix, chừa chỗ cho mail nhân viên gửi tay.
SMTP_GIOI_HAN_GIO=180

# ---- Web Push. Sinh cặp khoá:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@duhocitaiwan.com

# ---- Sao lưu ra ngoài VPS (deploy/backup-db.sh). Tên remote rclone + bucket, vd: r2:itaiwan-backup
BACKUP_REMOTE=
