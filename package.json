    "test:quyen": "node tests/phan-quyen.test.mjs",
    "test:luong": "node tests/luong-giaovien-hocvien.test.mjs",
    "test:du-hoc": "node tests/du-hoc.test.mjs",
    "test:diem": "node tests/chong-cay-diem.test.mjs",
    "test:du-hoc-hs": "node tests/du-hoc-hocvien.test.mjs",
    "test:quy-ktx-de": "node tests/quy-ktx-de.test.mjs",
