    "luyentap:tusinh": "node scripts/gen-luyentap-tusinh.mjs",
    "luyentap:kiem": "node scripts/kiem-tra-luyentap-tusinh.mjs",
    "baitap:kiem-toan": "node scripts/kiem-toan-bai-tap.mjs",
    "tocfl:vocab": "node scripts/gen-tocfl-vocab.mjs",
    "gv:tao": "node scripts/tao-giao-vien.mjs",
    "db:anon:local": "node scripts/anonymize-local.mjs"
