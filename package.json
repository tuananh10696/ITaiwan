    "mobile:ios": "node scripts/build-mobile.mjs && npx cap sync ios && npx cap open ios",
    "mobile:apk": "node scripts/build-mobile.mjs && npx cap sync android && node scripts/build-apk.mjs",
    "mobile:aab": "node scripts/build-mobile.mjs && npx cap sync android && node scripts/build-apk.mjs --aab",
    "mobile:assets": "npx -y @capacitor/assets generate --ios --android --iconBackgroundColor \"#38899E\" --iconBackgroundColorDark \"#2A6B7D\" --splashBackgroundColor \"#38899E\" --splashBackgroundColorDark \"#2A6B7D\"",
    "mobile:version": "node scripts/tang-phien-ban.mjs",
