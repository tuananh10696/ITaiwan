    "preview": "vite preview",
    "seo:sitemap": "node scripts/gen-sitemap.mjs",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "db:diff": "node scripts/db-diff.mjs",
