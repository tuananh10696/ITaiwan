  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
