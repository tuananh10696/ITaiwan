# Những thứ TUYỆT ĐỐI không được rời khỏi máy dev khi chạy `vercel --prod`.
# Vercel CLI dùng file này thay cho .gitignore, nên phải liệt kê đầy đủ.

# Bản dump DB — chứa email + hash mật khẩu học viên thật
backups/

# Biến môi trường và script chứa credential production
.env
.env.*
push_env.sh
push_env*.sh

# DB thử nghiệm, file rác, script test tạm
database.sqlite
_to_delete/
test_*.mjs
fix_*.mjs
create_test_users.mjs
scripts/claude-bridge.mjs
.bridge/

# Không cần cho bản build
tests/
md/
backups
dist/

# Cache dữ liệu nguồn để chạy script scrape trên máy dev — 8.1GB, KHÔNG cần cho bản chạy.
# Có file vượt 100MB (whisper/medium.bin 1.4GB, mtc-audio/*.rar) làm `vercel --prod`
# fail thẳng với "File size limit exceeded (100 MB)". .gitignore đã chặn phần nặng,
# nhưng Vercel CLI đọc .vercelignore chứ không đọc .gitignore nên phải khai lại ở đây.
scripts/data-cache/

# Bộ script MỘT LẦN thời scrape đề thi (1,6 MB gồm scraped_exams.json + de_thi.html).
# Chuyển từ thư mục gốc về đây 2026-09-06; app không dùng, nhưng trước đó KHÔNG có mục nào
# loại nên cả cụm vẫn đi vào bản deploy và tính vào trần 15.000 file.
scripts/legacy-de-thi/

# File credential thật — .gitignore đã chặn, nhưng Vercel CLI không đọc .gitignore
# nên trước đây vẫn bị upload lên hạ tầng Vercel mỗi lần deploy.
account.md

# Môi trường Python cho scripts/gen-tts-tuvung.py (25MB) và cache bytecode.
# Chỉ dùng trên máy dev, bản chạy không cần.
scripts/.venv/
scripts/__pycache__/

